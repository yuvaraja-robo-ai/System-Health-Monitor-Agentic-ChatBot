# SystemHealth — environment variables
# Copy to .env and fill in values, or export directly.
# All variables are optional unless noted.
#
# ⚠  SECURITY: Never commit a real .env. The .gitignore excludes it, but
#    double-check `git status` before every push. Rotate any key that even
#    briefly hit a tracked file — assume it is compromised.

# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=9090
RELOAD=1          # set to 0 in production

# ── Data storage ─────────────────────────────────────────
# SH_DATA_DIR=./data          # default: ./data

# ── Retention (seconds) ──────────────────────────────────
# SH_HISTORY_RAW_RETENTION_S=3600       # 1 hour raw samples
# SH_HISTORY_10S_RETENTION_S=86400      # 1 day 10-second samples
# SH_HISTORY_1M_RETENTION_S=2592000     # 30 days 1-minute samples

# ── LLM backend (optional) ───────────────────────────────
# Uncomment ONE of the following:
SH_OLLAMA_URL=http://127.0.0.1:11434
# SH_LLAMA_URL=http://127.0.0.1:8080

SH_LLM_MODEL=qwen3:1.7b
SH_LLM_FALLBACK_MODEL=nemotron-mini:4b
# SH_LLM_TIMEOUT_S=60

# ── Agent model config (no code change needed to swap models) ─
SH_EXECUTOR_PROVIDER=ollama
SH_EXECUTOR_MODEL=qwen3:1.7b
SH_VERIFIER_PROVIDER=ollama
SH_VERIFIER_MODEL=qwen3:1.7b
SH_UI_PROVIDER=ollama
SH_UI_MODEL=nemotron-mini:4b

# ── Cloud LLM provider keys (OPTIONAL — local Ollama needs none) ─────
# Only fill in if you route executor / verifier through a hosted provider.
# These are SECRETS. Treat them like passwords. Never paste into Slack,
# screenshots, or chat logs. Rotate immediately if exposed.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# NVIDIA_API_KEY=nvapi-...
# GITHUB_TOKEN=ghp_...

# ── Knowledge Base (requires pip install -e ".[kb]") ─────
# SH_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SH_KB_DIR=./data/kb

# ── App log monitoring ───────────────────────────────────
# Comma-separated directories to tail for application logs
# SH_LOG_APP_DIRS=["/var/log/myapp", "/opt/myapp/logs"]

# ── Anomaly detection ────────────────────────────────────
# SH_ANOMALY_WINDOW=60             # rolling buffer size (samples)
# SH_ANOMALY_MIN_SAMPLES=30        # min samples before flagging
# SH_ANOMALY_Z_THRESHOLD=3.0       # z-score threshold
# SH_ANOMALY_INTERVAL_S=2.0        # sample interval seconds

# ── Alerts (webhook) ─────────────────────────────────────
# ⚠  Webhook URLs are credentials — anyone with the URL can post to your
#    channel. Treat the same as an API key. Do not commit.
# SH_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SH_ALERT_COOLDOWN_S=300          # dedup window (5 min default)

# ── Optional collectors ──────────────────────────────────
# SH_ENABLE_DMESG=1    # enable kernel log collector (requires root or adm group)
