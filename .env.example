# SystemHealth — environment variables
# Copy to .env and fill in values, or export directly.
# All variables are optional unless noted.

# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=9090
RELOAD=1          # set to 0 in production

# ── Data storage ─────────────────────────────────────────
# SH_DATA_DIR=./data          # default: ./data

# ── Retention (seconds) ──────────────────────────────────
# SH_HISTORY_RAW_RETENTION_S=3600       # 1 hour raw samples
# SH_HISTORY_10S_RETENTION_S=86400      # 1 day 10-second samples
# SH_HISTORY_1M_RETENTION_S=2592000     # 30 days 1-minute samples

# ── LLM backend (optional) ───────────────────────────────
# Uncomment ONE of the following:
# SH_OLLAMA_URL=http://localhost:11434
# SH_LLAMA_URL=http://localhost:8081

# SH_LLM_MODEL=llama3.2:3b
# SH_LLM_TIMEOUT_S=30

# ── Knowledge Base (requires pip install -e ".[kb]") ─────
# SH_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SH_KB_DIR=./data/kb

# ── App log monitoring ───────────────────────────────────
# Comma-separated directories to tail for application logs
# SH_LOG_APP_DIRS=["/var/log/myapp", "/opt/myapp/logs"]

# ── Anomaly detection ────────────────────────────────────
# SH_ANOMALY_WINDOW=60             # rolling buffer size (samples)
# SH_ANOMALY_MIN_SAMPLES=30        # min samples before flagging
# SH_ANOMALY_Z_THRESHOLD=3.0       # z-score threshold
# SH_ANOMALY_INTERVAL_S=2.0        # sample interval seconds

# ── Alerts (webhook) ─────────────────────────────────────
# SH_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SH_ALERT_COOLDOWN_S=300          # dedup window (5 min default)

# ── Optional collectors ──────────────────────────────────
# SH_ENABLE_DMESG=1    # enable kernel log collector (requires root or adm group)
